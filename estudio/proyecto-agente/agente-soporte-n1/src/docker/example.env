# Plantilla de variables del Agente de Soporte N1. Es la fuente oficial de sus nombres.
# Copie este archivo como .env en esta misma carpeta y complete los valores.
# El .env nunca se sube al repositorio; este example.env sí, y sin valores reales.

# --- Conexión con el modelo (etapa 0): esto sí configura a qué modelo se le habla ---
# Gemini, por su punto de acceso compatible con OpenAI. La clave se crea en Google AI Studio.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Modelo de chat en uso: Gemini 3.1 Flash Lite (decisión D5). Otros modelos: ver la lista en Google AI Studio.
LLM_MODEL=gemini-3.1-flash-lite
# Con OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 y su clave y nombre de modelo.

# --- Embeddings para la base de conocimiento (etapa 2) ---
# Usan la misma URL y la misma clave de arriba (Gemini).
LLM_MODELO_EMBEDDINGS=gemini-embedding-001

# --- Base de datos (etapa 2) ---
POSTGRES_USER=agente
# Obligatoria desde la etapa 2: la imagen de PostgreSQL no arranca sin contraseña. Invente una.
POSTGRES_PASSWORD=
POSTGRES_DB=agente
# localhost cuando el código corre desde la terminal; el docker-compose lo cambia a "postgres".
POSTGRES_HOST=localhost

# --- Reglas de negocio del curso: no configuran el modelo, las aplica el programa ---
# Escalar si el caso supera 8 minutos (Módulo 2, sección 2.5).
MINUTOS_MAXIMOS_ANTES_DE_ESCALAR=8
# Revisar a mano entre el 5% y el 10% de los casos (Módulo 3, sección 3.3).
PORCENTAJE_MUESTREO_REVISION=10
# Tiempo de respuesta acordado para atender un caso escalado (Módulo 4, sección 4.3, paso 3). Valor del proyecto.
MINUTOS_RESPUESTA_TRASPASO=30

# --- Datos para calcular costos (Módulo 3, sección 3.2, y Módulo 5) ---
# No configuran el modelo ni se le envían: Google cobra igual. El programa los usa para pasar
# los tokens de cada ticket a dólares (costo por caso del panel 2, valor del panel 5 y ROI).
# Precio en dólares por millón de tokens de texto de gemini-3.1-flash-lite, según Google AI Studio el 2026-11-18.
# Si cambia el modelo o el precio, se actualizan aquí, en el .env y en la decisión D5.
PRECIO_MILLON_TOKENS_ENTRADA=0.25
PRECIO_MILLON_TOKENS_SALIDA=1.50
# Costo por hora de una persona de soporte, para el costo de los casos escalados (dato ficticio).
COSTO_HORA_PERSONA=
