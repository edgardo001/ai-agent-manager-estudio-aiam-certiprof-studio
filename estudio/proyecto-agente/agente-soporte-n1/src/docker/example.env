# Plantilla de variables del Agente de Soporte N1. Es la fuente oficial de sus nombres y su orden.
# Copie este archivo como .env en esta misma carpeta y complete los valores.
# El .env nunca se sube al repositorio; este example.env sí, y sin valores reales.
# Si esta plantilla cambia, desde src/backend: python -m scripts.revisar_env --ordenar
# deja su .env con el mismo orden y los mismos comentarios, conservando sus valores (D14).

# --- Proveedores de modelos: dirección y clave de cada uno (etapa 0) ---
# Solo hace falta la clave del proveedor que se use. Las direcciones son las públicas de cada
# servicio; están aquí para poder cambiarlas sin tocar el código. Detalle en docs/modelos-y-costos.md.
# Gemini, por su punto de acceso compatible con OpenAI. La clave se crea en Google AI Studio.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
# OpenRouter. La clave se crea en https://openrouter.ai/keys.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Ollama corre en el propio equipo y no pide clave; solo su dirección.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Modelo de chat: el que conversa y usa las herramientas (etapa 0) ---
# Proveedor: gemini, openrouter u ollama. Cambiar de proveedor es cambiar esta línea y el modelo.
LLM_PROVEEDOR=gemini
# Modelo en uso: Gemini 3.1 Flash Lite (decisión D5). Tiene que aceptar herramientas (tools);
# python -m scripts.prueba_conexion lo comprueba antes de usarlo.
# El nombre depende del proveedor: el mismo modelo es gemini-3.1-flash-lite en gemini y
# google/gemini-3.1-flash-lite en openrouter. Con el nombre del otro, el chat falla con un error 404.
#
# Modelos de chat que ofrecía cada proveedor el 2026-11-19 (las listas cambian; los de prueba
# o "preview" pueden desaparecer sin aviso). Para ver la lista de hoy, desde src/backend:
# python -m scripts.listar_modelos. Detalle en docs/modelos-y-costos.md, sección 2.
#   gemini (clave de Google AI Studio), se escriben sin prefijo:
#     gemini-3.1-flash-lite (en uso), gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash,
#     gemini-3.1-pro-preview, gemma-4-31b-it; y los alias gemini-flash-lite-latest,
#     gemini-flash-latest y gemini-pro-latest, que apuntan siempre a la versión más nueva
#     (cómodos, pero cambian solos: para las evals conviene un nombre fijo).
#   openrouter, gratuitos (terminan en :free; 50 pedidos al día, o 1.000 con 10 dólares cargados):
#     nvidia/nemotron-3-ultra-550b-a55b:free (probado en las etapas 3 y 4),
#     nvidia/nemotron-3.5-super-vl:free, nvidia/nemotron-3.5-lightning:free,
#     google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free, baidu/ernie-5.5-flash-preview:free.
#     Los de pago llevan el origen adelante, por ejemplo google/gemini-3.1-flash-lite.
#   ollama: el nombre del modelo descargado en el equipo (ollama list), por ejemplo qwen3.
LLM_MODEL=gemini-3.1-flash-lite
# Máximo de tokens que escribe el modelo por respuesta (el agente usa menos de 300). Sin tope,
# OpenRouter reserva saldo para la salida máxima del modelo y con poco saldo rechaza el pedido.
LLM_MAXIMO_TOKENS_SALIDA=2000

# --- Modelo de embeddings: los vectores de la base de conocimiento (etapa 2) ---
# Proveedor propio (decisión D13), para cambiar el chat sin recargar los vectores. Vacío: el del chat.
# Si se cambia el modelo de embeddings, hay que volver a ejecutar python -m scripts.cargar_conocimiento,
# porque los vectores solo se comparan con los de su mismo modelo (D8).
# Modelos de embeddings en gemini el 2026-11-19: gemini-embedding-001 (en uso) y gemini-embedding-2.
# En ollama, por ejemplo, nomic-embed-text (ollama pull nomic-embed-text).
LLM_EMBEDDINGS_PROVEEDOR=gemini
LLM_MODELO_EMBEDDINGS=gemini-embedding-001

# --- Modelo juez de las evals (etapa 5) ---
# Califica las respuestas del agente: fidelidad, alucinación, relevancia y tono (docs/evals-del-llm.md).
# Distinto y más capaz que el del agente, para que no se califique a sí mismo (decisión del usuario).
# Proveedor propio, como los embeddings (D13). Vacío: el del chat. Solo lo usan las evals.
LLM_JUEZ_PROVEEDOR=gemini
LLM_MODELO_JUEZ=gemini-3.5-flash

# --- Barrera de aprobación del prompt (etapa 5, D15) ---
# true: un prompt cuya huella no es la aprobada no atiende; el ticket pasa a una persona con el
# motivo "instrucciones sin aprobar". false: la diferencia solo queda anotada en la auditoría.
# Apagada en desarrollo y en las evals; encendida en QA y en uso real.
EXIGIR_PROMPT_APROBADO=false

# --- Base de datos (etapa 2) ---
POSTGRES_USER=agente
# Obligatoria desde la etapa 2: la imagen de PostgreSQL no arranca sin contraseña. Invente una.
POSTGRES_PASSWORD=
POSTGRES_DB=agente
# 127.0.0.1 cuando el código corre desde la terminal (start-dev.bat). No se usa "localhost":
# en Windows se prueba primero por IPv6 y cada conexión tarda 2 segundos de más (decisión D12).
# Desde la etapa 6, dentro de Docker (start-qa.bat), el docker-compose lo cambiará a "postgres".
POSTGRES_HOST=127.0.0.1

# --- Reglas de negocio del curso: no configuran el modelo, las aplica el programa ---
# Escalar si la atención de un mensaje supera 8 minutos (Módulo 2, sección 2.5). Lo usa reglas.py desde la etapa 4.
MINUTOS_MAXIMOS_ANTES_DE_ESCALAR=8
# Tope de tokens (entrada más salida) que puede gastar un ticket; si lo supera, se escala.
# Valor del proyecto, no viene en el curso: un ticket normal usa cerca de 4.000 (docs/modelos-y-costos.md).
TOPE_TOKENS_POR_TICKET=20000
# Revisar a mano entre el 5% y el 10% de los casos (Módulo 3, sección 3.3). Se lee desde la etapa 7.
PORCENTAJE_MUESTREO_REVISION=10
# Tiempo de respuesta acordado para atender un caso escalado (Módulo 4, sección 4.3, paso 3). Valor del proyecto. Se lee desde la etapa 7.
MINUTOS_RESPUESTA_TRASPASO=30

# --- Datos para calcular costos (Módulo 3, sección 3.2, y Módulo 5) ---
# No configuran el modelo ni se le envían. El programa los usa para pasar los tokens de cada
# ticket a dólares (costo por caso del panel 2, valor del panel 5 y ROI).
# Precio en dólares por millón de tokens de texto de gemini-3.1-flash-lite, según Google AI Studio el 2026-11-18.
# Si cambia el modelo o el precio, se actualizan aquí, en el .env y en la decisión D5 (un modelo gratuito: 0).
PRECIO_MILLON_TOKENS_ENTRADA=0.25
PRECIO_MILLON_TOKENS_SALIDA=1.50
# Precio en dólares por millón de tokens de gemini-embedding-001 (solo entrada), según Google el 2026-11-18.
PRECIO_MILLON_TOKENS_EMBEDDINGS=0.15
# Supuestos de estimar_costos.py (docs/modelos-y-costos.md): llamadas al modelo por consulta del cliente
# y límite de llamadas por minuto de su cuenta, que se ve en el panel del proveedor (vacío: no se compara).
LLAMADAS_POR_CONSULTA=3
LIMITE_LLAMADAS_POR_MINUTO=
# Costo por hora de una persona de soporte, para el costo de los casos escalados (dato ficticio). Se lee desde la etapa 7.
COSTO_HORA_PERSONA=
